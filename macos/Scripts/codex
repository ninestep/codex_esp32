#!/bin/zsh
set -u

script_path=${0:A}
macos_dir=${script_path:h:h}
bundled_helper=${script_path:h:h}/MacOS/codex-remote-helper
source_helper="$macos_dir/.build/debug/codex-remote-helper"
default_helper=$([[ -x "$bundled_helper" ]] && print -r -- "$bundled_helper" || print -r -- "$source_helper")
helper=${CODEX_REMOTE_HELPER:-"$default_helper"}
tmp_root=${TMPDIR:-/tmp}
tmp_root=${tmp_root%/}
socket_path=${CODEX_REMOTE_SOCKET:-"$tmp_root/codex-remote-$UID/events.sock"}

find_real_codex() {
  if [[ -n "${CODEX_REMOTE_REAL_CODEX:-}" ]]; then
    if [[ -x "$CODEX_REMOTE_REAL_CODEX" ]]; then
      print -r -- "$CODEX_REMOTE_REAL_CODEX"
      return 0
    fi
    return 1
  fi

  local self_path=${script_path:A}
  local dir candidate
  for dir in "${(@s/:/)PATH}"; do
    [[ -n "$dir" ]] || dir="."
    candidate="$dir/codex"
    if [[ -x "$candidate" && "${candidate:A}" != "$self_path" ]]; then
      print -r -- "${candidate:A}"
      return 0
    fi
  done
  return 1
}

real_codex=$(find_real_codex) || {
  print -u2 -r -- "codex shim: real codex not found"
  exit 127
}

launcher_id=${$(uuidgen 2>/dev/null):l}

if [[ -n "$launcher_id" ]]; then
  export CODEX_REMOTE_INSTANCE_ID="$launcher_id"

  if [[ -x "$helper" ]]; then
    "$helper" register-launch --socket "$socket_path" --launcher "$launcher_id" || {
      print -u2 -r -- "codex shim: helper register-launch failed"
    }
  else
    print -u2 -r -- "codex shim: helper unavailable"
  fi
else
  unset CODEX_REMOTE_INSTANCE_ID
  print -u2 -r -- "codex shim: launcher id unavailable"
fi

exec "$real_codex" "$@"
