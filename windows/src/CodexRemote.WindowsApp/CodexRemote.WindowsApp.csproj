<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CodexRemote.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <ProjectReference Include="..\CodexRemote.Windows\CodexRemote.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\CodexRemote.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
